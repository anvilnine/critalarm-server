# Crit Alarm server, every environment variable it reads.
#
#   cp .env.example .env
#
# Then fill in what you need and delete the rest. Nothing here is a real key.
# Never commit a filled-in .env: .gitignore keeps .env out and lets this file
# through, and that is the only safe shape.
#
# A value set here wins over the same value in critalarm.yml.

# ---------------------------------------------------------------------------
# Identity and networking
# ---------------------------------------------------------------------------

# Required. The public URL of this server, scheme included. Topic hashes are
# sha256(BASE_URL + "/" + topic), so changing this later breaks every topic
# that already exists. Pick it once, before the first boot.
BASE_URL=https://alerts.example.com

# Optional. Path to the YAML config file. Default: critalarm.yml in the working
# directory, and a missing file is fine.
# CONFIG_PATH=/etc/critalarm/critalarm.yml

# Optional. The address to listen on, ":port" only. Default ":8080".
# LISTEN=:8080

# Optional. The port, if you would rather set it on its own. Overrides the port
# in LISTEN. Default: whatever LISTEN says, so 8080.
# PORT=8080

# Optional. Where the SQLite file lives. Default "/data", which is the volume
# the Docker image declares. The file is DATA_DIR/critalarm.sqlite.
# DATA_DIR=/data

# Optional. Set to true when a reverse proxy sits in front, so the rate limiter
# reads the forwarded client IP instead of the proxy's. Without it every client
# shares one bucket. Default false.
BEHIND_PROXY=true

# Optional. "production" turns on the production checks: no no-op push, and a
# RevenueCat secret is required unless the server is in selfhosted mode. The
# Docker image sets this to production already.
# NODE_ENV=production

# ---------------------------------------------------------------------------
# Relay
# ---------------------------------------------------------------------------

# Optional. The relay this server forwards to, and the value that decides the
# mode. Push credentials plus RELAY_URL set means hosted mode. Push credentials
# alone means relay mode. No push credentials means selfhosted mode, and this
# server forwards its pushes to the relay below.
# Default: https://relay.critalarm.app
# RELAY_URL=https://relay.critalarm.app

# Optional. "none" keeps message text off the relay and the device fetches the
# real text itself. "full" sends title and body in the push. Default "none".
# RELAY_CONTENT=none

# ---------------------------------------------------------------------------
# Operations
# ---------------------------------------------------------------------------

# Optional. Bearer key for the /stats routes. Without it those routes are not
# mounted at all. Use a long random value.
# STATS_KEY=replace-with-a-long-random-string

# Optional. "true" logs one line per request: method, path, status, duration.
# No tokens, no message bodies, no push tokens. Default off.
# LOG_REQUESTS=false

# Optional. Sentry-compatible DSN for crash reporting (GlitchTip). Off when
# unset, which is the default.
# GLITCHTIP_DSN=https://publickey@glitchtip.example.com/1

# Optional, development only. "true" lets the server start with no push
# provider and drop pushes on the floor. Ignored when NODE_ENV=production.
# ALLOW_NOOP_PUSH=true

# ---------------------------------------------------------------------------
# Apple push (APNs). All four of TEAM_ID, KEY_ID, PRIVATE_KEY and BUNDLE_ID
# together, or none of them.
# ---------------------------------------------------------------------------

# APNS_TEAM_ID=ABCDE12345
# APNS_KEY_ID=FGHIJ67890
# APNS_BUNDLE_ID=app.example.client

# The contents of the .p8 file, not a path to it. If your tooling cannot carry
# real newlines, paste the one-line form with \n between the lines and the
# server will unescape it.
# APNS_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_YOUR_KEY\n-----END PRIVATE KEY-----\n

# "production" or "sandbox". Default "production". A debug build of an iOS app
# is registered in sandbox, so a production server cannot reach it.
# APNS_ENVIRONMENT=production

# ---------------------------------------------------------------------------
# Android push (FCM). PROJECT_ID, CLIENT_EMAIL and PRIVATE_KEY together, or
# none. All three come out of the service account JSON.
# ---------------------------------------------------------------------------

# FCM_PROJECT_ID=your-firebase-project
# FCM_CLIENT_EMAIL=firebase-adminsdk@your-firebase-project.iam.gserviceaccount.com

# The "private_key" field of the service account JSON. The \n form that the
# JSON file already uses is fine; the server unescapes it.
# FCM_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_YOUR_KEY\n-----END PRIVATE KEY-----\n

# Optional. Only change this to point at a fake token endpoint in tests.
# Default: https://oauth2.googleapis.com/token
# FCM_TOKEN_URL=https://oauth2.googleapis.com/token

# ---------------------------------------------------------------------------
# Subscriptions
# ---------------------------------------------------------------------------

# The shared secret RevenueCat signs its webhook with. Required when NODE_ENV
# is production and the mode is not selfhosted: the server refuses to boot
# without it. A random value is fine while there is no purchase path, and it
# keeps the webhook closed.
# REVENUECAT_SHARED_SECRET=replace-with-a-long-random-string

# ---------------------------------------------------------------------------
# Litestream, used only by the sidecar in docker-compose.yml. Skip all of this
# if you run the single container on its own.
# ---------------------------------------------------------------------------

# The database file to replicate. Matches DATA_DIR.
# LITESTREAM_DB_PATH=/data/critalarm.sqlite

# Bucket name, and the prefix inside it.
# LITESTREAM_BUCKET=critalarm-backups
# LITESTREAM_PATH=critalarm

# S3-compatible endpoint. For Cloudflare R2 this is
# https://<account-id>.r2.cloudflarestorage.com
# LITESTREAM_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com

# R2 wants "auto". Real S3 wants its region, for example us-east-1.
# LITESTREAM_REGION=auto

# The API token for that bucket. Read and write on this one bucket, nothing
# else. Treat both as secrets.
# LITESTREAM_ACCESS_KEY_ID=replace-with-your-access-key-id
# LITESTREAM_SECRET_ACCESS_KEY=replace-with-your-secret-access-key
