{
  "name": "critalarm-server",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "main": "./src/main.ts",
  "bin": {
    "critalarm": "./bin/critalarm.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "tsx src/main.ts",
    "build": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "release": "./scripts/release.sh"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "better-auth": "^1.7.14",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.16",
    "tsx": "^4.19.2",
    "yaml": "^2.9.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22",
    "typescript": "^5",
    "vitest": "^4.1.2"
  }
}
