{
  "name": "critalarm-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/main.ts",
  "bin": { "critalarm": "./bin/critalarm.mjs" },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "tsx src/main.ts",
    "build": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@sentry/node": "^9",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.12.12",
    "hono-rate-limiter": "^0.4.2",
    "tsx": "^4.19.2",
    "yaml": "^2.9.0",
    "zod": "^4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26",
    "typescript": "^7",
    "vitest": "^5.0.0"
  }
}
